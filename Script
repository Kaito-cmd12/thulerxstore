<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THULERX STORE | A Melhor Loja Gamer Roblox</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        :root {
            --bg-main: #05050A;
            --bg-card: rgba(15, 15, 26, 0.7);
            --bg-header: rgba(9, 10, 20, 0.85);
            --primary: #2563EB;
            --primary-glow: rgba(24, 95, 210, 0.5);
            --secondary: #3B82F6;
            --secondary-glow: rgba(59, 130, 246, 0.5);
            --accent: #06B6D4;
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
            --border-neon: rgba(139, 92, 246, 0.25);
            --green-glow: #10B981;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html { scroll-behavior: smooth; }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            overflow-x: hidden;
            position: relative;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.18), transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.18), transparent 45%),
                radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.08), transparent 50%);
            z-index: -2;
        }

        body::after {
            content: "";
            position: fixed;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(rgba(139, 92, 246, 0.12) 1px, transparent 1px);
            background-size: 35px 35px;
            opacity: .4;
            z-index: -1;
            animation: gridMove 25s linear infinite;
        }

        @keyframes gridMove {
            0% { transform: translateY(0); }
            100% { transform: translateY(-35px); }
        }

        /* Toast Notification */
        .toast-container {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .toast {
            background: linear-gradient(135deg, rgba(15, 15, 30, 0.95), rgba(25, 20, 45, 0.95));
            border: 1px solid var(--primary);
            box-shadow: 0 8px 25px rgba(139, 92, 246, 0.35);
            color: white;
            padding: 14px 22px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(10px);
            animation: slideUp 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .toast i {
            color: var(--green-glow);
            font-size: 18px;
            filter: drop-shadow(0 0 6px rgba(16, 185, 129, 0.6));
        }

        @keyframes slideUp {
            from { transform: translateY(100%) scale(0.9); opacity: 0; }
            to { transform: translateY(0) scale(1); opacity: 1; }
        }

        .promo-banner {
            background: linear-gradient(90deg, #7C3AED, #2563EB, #06B6D4);
            background-size: 200% 200%;
            animation: gradientShift 6s ease infinite;
            text-align: center;
            padding: 8px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        header {
            width: 100%;
            padding: 16px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            backdrop-filter: blur(20px);
            background: var(--bg-header);
            border-bottom: 1px solid var(--border-neon);
            z-index: 999;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .logo-icon {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .logo span { color: var(--secondary); }

        nav { display: flex; gap: 20px; align-items: center; }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: .3s;
            cursor: pointer;
        }

        nav a:hover {
            color: var(--text-main);
            text-shadow: 0 0 10px var(--primary-glow);
        }

        .nav-actions { display: flex; gap: 12px; align-items: center; }

        .cart-btn-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            color: white;
            padding: 10px 16px;
            border-radius: 10px;
            cursor: pointer;
            position: relative;
            font-weight: 600;
            transition: .3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cart-btn-btn:hover { border-color: var(--secondary); box-shadow: 0 0 15px var(--secondary-glow); }

        .cart-count {
            position: absolute;
            top: -6px;
            right: -6px;
            background: var(--primary);
            color: white;
            font-size: 11px;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        /* Hero */
        .hero {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 60px 20px;
        }

        .hero-badge {
            background: rgba(139, 92, 246, 0.15);
            border: 1px solid var(--primary);
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 25px;
            display: inline-block;
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .hero h1 {
            font-size: 60px;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 17px;
            color: var(--text-muted);
            max-width: 750px;
            margin: auto;
            line-height: 1.6;
            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 26px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: .3s;
            cursor: pointer;
            border: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            box-shadow: 0 0 20px var(--primary-glow);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 35px var(--secondary-glow);
        }

        .btn-secondary {
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            color: white;
        }

        .btn-secondary:hover {
            border-color: var(--secondary);
            background: rgba(59, 130, 246, 0.1);
        }

        .btn-danger {
            background: #EF4444;
            color: white;
        }

        .btn-danger:hover {
            background: #DC2626;
        }

        /* Features */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            padding: 0 8% 80px 8%;
        }

        .feature-card {
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            padding: 25px;
            border-radius: 16px;
            text-align: center;
            backdrop-filter: blur(10px);
            transition: .3s;
        }

        .feature-card:hover {
            border-color: var(--secondary);
            transform: translateY(-5px);
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.2);
        }

        .feature-card i {
            font-size: 32px;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .feature-card h3 { font-size: 18px; margin-bottom: 8px; }
        .feature-card p { font-size: 13px; color: var(--text-muted); }

        /* Catálogo */
        .catalog-section {
            padding: 60px 8%;
            border-top: 1px solid var(--border-neon);
        }

        .section-header { text-align: center; margin-bottom: 40px; }
        .section-header h2 { font-size: 36px; font-weight: 800; }
        .section-header p { color: var(--text-muted); font-size: 15px; }

        .catalog-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 35px;
        }

        .category-tabs { display: flex; gap: 10px; flex-wrap: wrap; }

        .tab-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            color: var(--text-muted);
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: .3s;
        }

        .tab-btn.active, .tab-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .search-box { position: relative; min-width: 250px; }

        .search-box input {
            width: 100%;
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            padding: 10px 15px 10px 40px;
            border-radius: 10px;
            color: white;
            outline: none;
            font-size: 14px;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 25px;
        }

        .product-card {
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            border-radius: 18px;
            padding: 18px;
            position: relative;
            transition: .35s;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .product-card:hover {
            border-color: var(--secondary);
            transform: translateY(-6px);
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.25);
        }

        .product-tag {
            position: absolute;
            top: 25px;
            left: 25px;
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid var(--border-neon);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            color: var(--accent);
            z-index: 2;
        }

        .product-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 15px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .product-title { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
        .product-desc { font-size: 12px; color: var(--text-muted); margin-bottom: 15px; line-height: 1.4; }

        .stock-status {
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .stock-available { color: var(--green-glow); }
        .stock-low { color: #F59E0B; }

        .product-bottom {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .product-price { font-size: 20px; font-weight: 800; color: #10B981; }

        .product-actions { display: flex; gap: 8px; }

        .action-btn-cart {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-neon);
            color: white;
            padding: 9px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            transition: .3s;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .action-btn-cart:hover { border-color: var(--primary); background: rgba(139, 92, 246, 0.2); }

        .action-btn-buy {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            color: white;
            padding: 9px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            transition: .3s;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .action-btn-buy:hover { box-shadow: 0 0 15px var(--primary-glow); }

        /* Avaliações */
        .reviews-section { padding: 60px 8%; background: rgba(0, 0, 0, 0.3); }
        .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }

        .review-card {
            background: var(--bg-card);
            border: 1px solid var(--border-neon);
            padding: 20px;
            border-radius: 14px;
        }

        .review-header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .stars { color: #F59E0B; font-size: 12px; }

        /* Modais */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(10px);
            z-index: 10000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-content {
            background: #090B14;
            border: 1px solid var(--primary);
            width: 100%;
            max-width: 550px;
            border-radius: 20px;
            padding: 28px;
            position: relative;
            box-shadow: 0 0 40px var(--primary-glow);
            max-height: 90vh;
            overflow-y: auto;
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 20px;
            color: var(--text-muted);
            cursor: pointer;
            transition: .2s;
        }

        .close-modal:hover { color: white; }

        /* Stepper do Carrinho */
        .cart-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
            position: relative;
        }

        .cart-steps::before {
            content: "";
            position: absolute;
            top: 15px;
            left: 10%;
            right: 10%;
            height: 2px;
            background: var(--border-neon);
            z-index: 1;
        }

        .step-item {
            position: relative;
            z-index: 2;
            background: #090B14;
            padding: 0 10px;
            text-align: center;
        }

        .step-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #121626;
            border: 1px solid var(--border-neon);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 5px auto;
            font-size: 13px;
            color: var(--text-muted);
        }

        .step-item.active .step-icon {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .step-title { font-size: 11px; color: var(--text-muted); font-weight: 600; }
        .step-item.active .step-title { color: white; }

        /* Cards do Carrinho */
        .cart-item-card {
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-neon);
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 12px;
        }

        .cart-item-img { width: 55px; height: 55px; object-fit: cover; border-radius: 8px; }

        .qty-control {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #000;
            border: 1px solid var(--border-neon);
            padding: 4px 8px;
            border-radius: 6px;
        }

        .qty-btn { background: none; border: none; color: white; cursor: pointer; font-weight: 800; }

        /* Pix Box */
        .pix-box {
            background: #05070D;
            border: 1px dashed var(--secondary);
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
            text-align: center;
            word-break: break-all;
            font-family: monospace;
            font-size: 11px;
            color: var(--accent);
        }

        /* Inputs */
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-size: 12px; margin-bottom: 5px; color: var(--text-muted); }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            background: #05070D;
            border: 1px solid var(--border-neon);
            padding: 12px;
            border-radius: 8px;
            color: white;
            font-size: 13px;
            outline: none;
        }

        .form-group input:focus { border-color: var(--primary); }

        /* Abas Suporte e Admin */
        .tab-nav { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border-neon); padding-bottom: 10px; }
        .tab-nav-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-weight: 700;
            padding: 8px 12px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            font-size: 13px;
        }
        .tab-nav-btn.active { color: var(--primary); border-color: var(--primary); }

        /* Chat Suporte UI */
        .chat-box {
            height: 250px;
            background: #05070D;
            border: 1px solid var(--border-neon);
            border-radius: 10px;
            padding: 12px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 10px;
        }

        .chat-msg {
            max-width: 80%;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 12px;
            line-height: 1.4;
        }

        .msg-support {
            background: rgba(139, 92, 246, 0.2);
            border: 1px solid var(--primary);
            align-self: flex-start;
        }

        .msg-user {
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid var(--secondary);
            align-self: flex-end;
        }

        .chat-client-item {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-neon);
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: .2s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-client-item:hover { border-color: var(--primary); background: rgba(139, 92, 246, 0.1); }

        /* FAQ Accordion */
        .faq-item {
            background: #05070D;
            border: 1px solid var(--border-neon);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 8px;
        }
        .faq-q { font-weight: 700; font-size: 13px; color: white; margin-bottom: 5px; }
        .faq-a { font-size: 12px; color: var(--text-muted); }

        /* Stats Cards Admin */
        .admin-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px; }
        .stat-card { background: #05070D; border: 1px solid var(--border-neon); padding: 12px; border-radius: 10px; text-align: center; }
        .stat-card .val { font-size: 18px; font-weight: 800; color: var(--green-glow); }
        .stat-card .lbl { font-size: 11px; color: var(--text-muted); }

        /* Box de Conclusão / Avaliação */
        .completed-chat-box {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid #10B981;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            margin-top: 10px;
        }

        footer {
            border-top: 1px solid var(--border-neon);
            padding: 40px 8%;
            background: #030408;
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
        }

        footer .socials { display: flex; justify-content: center; gap: 20px; margin-bottom: 20px; font-size: 20px; }
        footer .socials a { color: var(--text-muted); transition: .3s; }
        footer .socials a:hover { color: var(--primary); }

        @media (max-width: 768px) {
            header { padding: 15px 5%; }
            nav { display: none; }
            .hero h1 { font-size: 42px; }
            .hero p { font-size: 15px; }
            .catalog-controls { flex-direction: column; align-items: stretch; }
            .admin-stats { grid-template-columns: 1fr; }
            .toast-container { bottom: 15px; right: 15px; left: 15px; }
        }
    </style>
</head>

<body>

    <div class="toast-container" id="toastContainer"></div>

    <div class="promo-banner">
        🔥 CUPOM "THULERX10" PARA 10% OFF NO PIX | ATENDIMENTO RÁPIDO VIA CHAT!
    </div>

    <!-- Header -->
    <header>
        <div class="logo" onclick="window.scrollTo(0,0)">
            <div class="logo-icon"><i class="fa-solid fa-gamepad text-white"></i></div>
            THULERX <span>STORE</span>
        </div>

        <nav>
            <a href="#home">Início</a>
            <a href="#catalog">Catálogo</a>
            <a href="#reviews">Avaliações</a>
            <a onclick="openMyOrdersModal()"><i class="fa-solid fa-box-open"></i> Meus Pedidos</a>
            <a onclick="openSupportModal()"><i class="fa-solid fa-headset"></i> Suporte</a>
        </nav>

        <div class="nav-actions">
            <button class="cart-btn-btn" onclick="openCart()">
                <i class="fa-solid fa-cart-shopping"></i>
