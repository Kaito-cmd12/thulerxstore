                <h4 style="margin-bottom: 15px;">Configurações Gerais</h4>
                <div class="form-group">
                    <label>Chave Pix da Loja</label>
                    <input type="text" id="admPixConfig" value="00020126580014BR.GOV.BCB.PIX0136123e4567-e89b-12d3-a456-426614174000520400005303986540510.005802BR5913THULERXSTORE">
                </div>
                <button class="btn btn-primary" style="width: 100%; justify-content: center;" onclick="saveSettingsAdmin()">Salvar Alterações</button>
            </div>

        </div>
    </div>

    <script>
        let products = [
            { id: 1, name: "Kitsune Fruit (Permanente)", category: "Blox Fruits", price: 149.90, stock: "Disponível", img: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400", desc: "Fruta permanente Kitsune pronta para entrega na sua conta do Blox Fruits." },
            { id: 2, name: "Pacote 4.500 Robux", category: "Robux", price: 119.90, stock: "Disponível", img: "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=400", desc: "Robux creditados via Gamepass ou Grupo com segurança total." },
            { id: 3, name: "Mística Garden Kit", category: "Grow a Garden 2", price: 39.90, stock: "Últimas Unidades", img: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400", desc: "Sementes raras e ferramentas lendárias para turbinar seu jardim." },
            { id: 4, name: "Dragon Fruit (Permanente)", category: "Blox Fruits", price: 179.90, stock: "Disponível", img: "https://images.unsplash.com/photo-1563089145-599997674d42?w=400", desc: "Uma das frutas mais poderosas e cobiçadas do jogo." }
        ];

        let cart = [];
        let checkoutItems = [];
        let salesHistory = [];
        let isStaff = false;
        let activeStaffClientNick = null;

        let supportChats = {
            "Cliente_Visitante": {
                closed: false,
                evaluated: false,
                messages: [
                    { sender: "support", text: "👋 Olá! Bem-vindo ao atendimento da THULERX STORE. Como podemos te ajudar hoje?" }
                ]
            }
        };

        // NOTIFICAÇÃO TOAST NO CANTO INFERIOR DIREITO
        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'slideUp 0.3s reverse forwards';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // GERENCIAMENTO DA EQUIPE / LOGIN
        function openStaffAuthModal() {
            if (isStaff) {
                if (confirm('Deseja sair do modo Equipe?')) {
                    isStaff = false;
                    document.getElementById('staffBtnText').innerText = 'Equipe';
                    document.getElementById('staffBtnToggle').style.borderColor = 'var(--border-neon)';
                    showToast('Você saiu do modo Equipe.');
                }
            } else {
                document.getElementById('staffPassError').style.display = 'none';
                document.getElementById('staffAuthModal').style.display = 'flex';
            }
        }

        function closeStaffAuthModal() { 
            document.getElementById('staffAuthModal').style.display = 'none'; 
        }

        function loginStaff() {
            const pass = document.getElementById('staffPassInput').value;
            const errEl = document.getElementById('staffPassError');

            if (pass === 'admin123' || pass === 'admin') {
                isStaff = true;
                errEl.style.display = 'none';
                document.getElementById('staffPassInput').value = '';
                closeStaffAuthModal();
                document.getElementById('staffBtnText').innerText = 'Equipe (Online)';
                document.getElementById('staffBtnToggle').style.borderColor = 'var(--green-glow)';
                showToast('🔑 Acesso liberado! Bem-vindo, Atendente.');
                openAdminModal();
            } else {
                errEl.style.display = 'block';
            }
        }

        function renderProducts(itemsToRender = products) {
            const grid = document.getElementById('productsGrid');
            grid.innerHTML = '';

            itemsToRender.forEach(p => {
                const stockClass = p.stock === 'Disponível' ? 'stock-available' : 'stock-low';
                grid.innerHTML += `
                    <div class="product-card">
                        <span class="product-tag">${p.category}</span>
                        <img src="${p.img}" alt="${p.name}" class="product-img">
                        <div class="product-title">${p.name}</div>
                        <div class="product-desc">${p.desc}</div>
                        <div class="stock-status ${stockClass}">
                            <i class="fa-solid fa-box"></i> ${p.stock}
                        </div>
                        <div class="product-bottom">
                            <div class="product-price">R$ ${p.price.toFixed(2).replace('.', ',')}</div>
                            <div class="product-actions">
                                <button class="action-btn-cart" onclick="addToCart(${p.id})">
                                    <i class="fa-solid fa-cart-plus"></i> + Carrinho
                                </button>
                                <button class="action-btn-buy" onclick="buyNow(${p.id})">
                                    Comprar
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
            updateAdminStats();
        }

        function filterCategory(cat) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
            if (cat === 'all') renderProducts(products);
            else renderProducts(products.filter(p => p.category === cat));
        }

        function searchProducts() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            renderProducts(products.filter(p => p.name.toLowerCase().includes(query) || p.category.toLowerCase().includes(query)));
        }

        function addToCart(id) {
            const product = products.find(p => p.id === id);
            const cartItem = cart.find(item => item.id === id);

            if (cartItem) cartItem.qty += 1;
            else cart.push({ ...product, qty: 1 });

            updateCartUI();
            showToast(`Item "${product.name}" adicionado ao carrinho!`);
        }

        function buyNow(id) {
            const product = products.find(p => p.id === id);
            checkoutItems = [{ ...product, qty: 1 }];
            openCart(true);
        }

        function changeQty(index, delta, isBuyNow = false) {
            const list = isBuyNow ? checkoutItems : cart;
            list[index].qty += delta;
            if (list[index].qty <= 0) list.splice(index, 1);
            updateCartUI(isBuyNow);
        }

        function updateCartUI(isBuyNow = false) {
            const list = isBuyNow ? checkoutItems : cart;
            const totalCount = cart.reduce((acc, item) => acc + item.qty, 0);
            document.getElementById('cartCount').innerText = totalCount;

            const cartList = document.getElementById('cartItemsList');
            cartList.innerHTML = '';

            let subtotal = 0;
            if (list.length === 0) {
                cartList.innerHTML = `<div style="text-align:center; color:var(--text-muted); padding:20px;">Nenhum item selecionado.</div>`;
            } else {
                list.forEach((item, index) => {
                    subtotal += item.price * item.qty;
                    cartList.innerHTML += `
                        <div class="cart-item-card">
                            <img src="${item.img}" class="cart-item-img">
                            <div style="flex:1;">
                                <div style="font-size:13px; font-weight:700;">${item.name}</div>
                                <div style="font-size:12px; color:#10B981; font-weight:700;">R$ ${(item.price * item.qty).toFixed(2)}</div>
                            </div>
                            <div class="qty-control">
                                <button class="qty-btn" onclick="changeQty(${index}, -1, ${isBuyNow})">-</button>
                                <span style="font-size:12px; font-weight:700;">${item.qty}</span>
                                <button class="qty-btn" onclick="changeQty(${index}, 1, ${isBuyNow})">+</button>
                            </div>
                        </div>
                    `;
                });
            }

            const discount = subtotal * 0.10;
            const total = subtotal - discount;

            document.getElementById('cartSubtotal').innerText = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
            document.getElementById('cartDiscount').innerText = `- R$ ${discount.toFixed(2).replace('.', ',')}`;
            document.getElementById('cartTotal').innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
        }

        function goToStep(step) {
            const activeList = checkoutItems.length > 0 ? checkoutItems : cart;
            if (step === 2 && activeList.length === 0) {
                alert('Nenhum item selecionado!');
                return;
            }
            if (step === 3) {
                const nick = document.getElementById('clientNick').value;
                if (!nick) {
                    alert('Por favor, digite seu Nick do Roblox para continuar!');
                    return;
                }
            }

            document.getElementById('cartStep1').style.display = step === 1 ? 'block' : 'none';
            document.getElementById('cartStep2').style.display = step === 2 ? 'block' : 'none';
            document.getElementById('cartStep3').style.display = step === 3 ? 'block' : 'none';

            document.getElementById('stepIndicator1').className = `step-item ${step >= 1 ? 'active' : ''}`;
            document.getElementById('stepIndicator2').className = `step-item ${step >= 2 ? 'active' : ''}`;
            document.getElementById('stepIndicator3').className = `step-item ${step >= 3 ? 'active' : ''}`;
        }

        function openCart(isBuyNow = false) { 
            if (!isBuyNow) checkoutItems = [];
            updateCartUI(isBuyNow);
            goToStep(1);
            document.getElementById('cartModal').style.display = 'flex'; 
        }

        function closeCart() { document.getElementById('cartModal').style.display = 'none'; }

        function copyPix() {
            const pixText = document.getElementById('pixKey').innerText;
            navigator.clipboard.writeText(pixText);
            showToast('Chave Pix Copiada com sucesso!');
        }

        function finishOrder() {
            const nick = document.getElementById('clientNick').value.trim();
            const receipt = document.getElementById('receiptInput').value;
            const itemsToBuy = checkoutItems.length > 0 ? checkoutItems : cart;

            const total = itemsToBuy.reduce((acc, item) => acc + (item.price * item.qty), 0) * 0.90;

            const order = {
                id: Date.now(),
                nick, receipt,
                total, items: [...itemsToBuy],
                date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString()
            };

            salesHistory.push(order);

            if (!supportChats[nick]) {
                supportChats[nick] = {
                    closed: false,
                    evaluated: false,
                    messages: [
                        { sender: "support", text: `👋 Olá ${nick}! Recebemos seu pedido #${order.id.toString().slice(-5)}. Em que podemos ajudar com a entrega?` }
                    ]
                };
            } else {
                supportChats[nick].closed = false;
            }

            if (checkoutItems.length > 0) checkoutItems = [];
            else cart = [];

            updateCartUI();
            closeCart();
            updateAdminStats();

            document.getElementById('postPurchaseModal').style.display = 'flex';
        }

        function closePostPurchaseModal() {
            document.getElementById('postPurchaseModal').style.display = 'none';
        }

        function goToSupportFromPurchase() {
            closePostPurchaseModal();
            openSupportModal('chat');
        }

        /* Meus Pedidos */
        function openMyOrdersModal() { document.getElementById('myOrdersModal').style.display = 'flex'; }
        function closeMyOrdersModal() { document.getElementById('myOrdersModal').style.display = 'none'; }

        function searchMyOrders() {
            const nick = document.getElementById('searchNickOrders').value.toLowerCase().trim();
            const res = document.getElementById('myOrdersResults');

            if (!nick) {
                res.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 20px;">Por favor, informe seu nick.</div>`;
                return;
            }

            const myOrders = salesHistory.filter(o => o.nick.toLowerCase() === nick);

            if (myOrders.length === 0) {
                res.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhum pedido encontrado para o nick "<strong>${nick}</strong>".</div>`;
                return;
            }

            res.innerHTML = '';
            myOrders.forEach(o => {
                let itemsHtml = o.items.map(i => `${i.name} (x${i.qty})`).join(', ');
                res.innerHTML += `
                    <div style="background:#05070D; border:1px solid var(--border-neon); padding:12px; border-radius:10px; margin-bottom:10px; font-size:12px;">
                        <div style="display:flex; justify-content:space-between; font-weight:700; margin-bottom:5px;">
                            <span>Pedido #${o.id.toString().slice(-5)}</span>
                            <span style="color:#10B981;">R$ ${o.total.toFixed(2)}</span>
                        </div>
                        <div style="color:var(--text-muted); margin-bottom:4px;">Itens: ${itemsHtml}</div>
                        <div style="font-size:11px; color:var(--accent);">Data: ${o.date}</div>
                    </div>
                `;
            });
        }

        /* Suporte */
        function openSupportModal(tab = 'chat') {
            document.getElementById('supportModal').style.display = 'flex';
            switchSupportTab(tab);
        }
        function closeSupportModal() { document.getElementById('supportModal').style.display = 'none'; }

        function switchSupportTab(tab) {
            document.getElementById('btnSupportChat').classList.toggle('active', tab === 'chat');
            document.getElementById('btnSupportFaq').classList.toggle('active', tab === 'faq');
            document.getElementById('btnSupportHours').classList.toggle('active', tab === 'hours');

            document.getElementById('suppTabChat').style.display = tab === 'chat' ? 'block' : 'none';
            document.getElementById('suppTabFaq').style.display = tab === 'faq' ? 'block' : 'none';
            document.getElementById('suppTabHours').style.display = tab === 'hours' ? 'block' : 'none';

            if (tab === 'chat') {
                if (isStaff) {
                    document.getElementById('clientChatView').style.display = 'none';
                    document.getElementById('staffChatView').style.display = 'block';
                    renderStaffChatList();
                } else {
                    document.getElementById('clientChatView').style.display = 'block';
                    document.getElementById('staffChatView').style.display = 'none';
                    renderClientChat();
                }
            }
        }

        function getCurrentUserNick() {
            const inputNick = document.getElementById('clientNick').value.trim();
            return inputNick || "Cliente_Visitante";
        }

        function renderClientChat() {
            const userKey = getCurrentUserNick();
            if (!supportChats[userKey]) {
                supportChats[userKey] = {
                    closed: false,
                    evaluated: false,
                    messages: [
                        { sender: "support", text: `👋 Olá! Bem-vindo ao suporte da THULERX STORE. Como podemos te ajudar?` }
                    ]
                };
            }

            const box = document.getElementById('chatBox');
            box.innerHTML = '';
            const chatData = supportChats[userKey];

            chatData.messages.forEach(msg => {
                const msgClass = msg.sender === 'user' ? 'msg-user' : 'msg-support';
                box.innerHTML += `<div class="chat-msg ${msgClass}">${msg.text}</div>`;
            });
            box.scrollTop = box.scrollHeight;

            if (chatData.closed) {
                document.getElementById('clientChatInputArea').style.display = 'none';
                document.getElementById('clientEvaluationArea').style.display = 'block';
            } else {
                document.getElementById('clientChatInputArea').style.display = 'flex';
                document.getElementById('clientEvaluationArea').style.display = 'none';
            }
        }

        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const txt = input.value.trim();
            if (!txt) return;

            const userKey = getCurrentUserNick();
            if (!supportChats[userKey]) {
                supportChats[userKey] = { closed: false, evaluated: false, messages: [] };
            }

            supportChats[userKey].messages.push({ sender: 'user', text: txt });
            input.value = '';
            renderClientChat();
        }

        function showRatingForm() {
            document.getElementById('evalTriggerBtn').style.display = 'none';
            document.getElementById('evalForm').style.display = 'block';
        }

        function submitRating() {
            const score = document.getElementById('evalScore').value;
            const comment = document.getElementById('evalComment').value.trim();
            const nick = getCurrentUserNick();

            const reviewsGrid = document.getElementById('reviewsGrid');
            const initialLetter = nick.charAt(0).toUpperCase() || 'C';

            let starsCount = Math.round(score / 2);
            if (starsCount < 1) starsCount = 1;
            let starsHtml = '';
            for (let i = 0; i < starsCount; i++) {
                starsHtml += '<i class="fa-solid fa-star"></i>';
            }

            const newReviewHtml = `
                <div class="review-card">
                    <div class="review-header">
                        <div class="avatar">${initialLetter}</div>
                        <div>
                            <div style="font-weight: 700;">${nick} (Nota: ${score}/10)</div>
                            <div class="stars">${starsHtml}</div>
                        </div>
                    </div>
                    <p style="font-size: 13px; color: var(--text-muted);">${comment ? `"${comment}"` : '"Atendimento excelente!"'}</p>
                </div>
            `;

            reviewsGrid.insertAdjacentHTML('afterbegin', newReviewHtml);

            if (supportChats[nick]) {
                supportChats[nick].evaluated = true;
            }

            document.getElementById('clientEvaluationArea').innerHTML = `
                <div class="completed-chat-box">
                    <i class="fa-solid fa-heart" style="font-size:32px; color:#10B981; margin-bottom:8px;"></i>
                    <h4 style="font-size:16px; color:white;">Obrigado por avaliar!</h4>
                    <p style="font-size:12px; color:var(--text-muted); margin-top:5px;">Sua opinião nos ajuda a melhorar cada vez mais!</p>
                </div>
            `;

            showToast('Avaliação enviada com sucesso!');
        }

        function renderStaffChatList() {
            const list = document.getElementById('staffChatsList');
            list.innerHTML = '';

            const keys = Object.keys(supportChats);
            if (keys.length === 0) {
                list.innerHTML = `<div style="text-align:center; color:var(--text-muted); padding:20px;">Nenhum chamado pendente.</div>`;
                return;
            }

            keys.forEach(nick => {
                const chatData = supportChats[nick];
                const msgs = chatData.messages;
                const lastMsg = msgs[msgs.length - 1] ? msgs[msgs.length - 1].text : "Sem mensagens";
                const statusBadge = chatData.closed ? '<span style="color:#EF4444; font-size:10px;">[Concluído]</span>' : '<span style="color:#10B981; font-size:10px;">[Aberto]</span>';

                list.innerHTML += `
                    <div class="chat-client-item" onclick="openStaffClientChat('${nick}')">
                        <div>
                            <div style="font-weight:700; font-size:13px; color:white;"><i class="fa-solid fa-user"></i> ${nick} ${statusBadge}</div>
                            <div style="font-size:11px; color:var(--text-muted);">${lastMsg.slice(0, 35)}...</div>
                        </div>
                        <i class="fa-solid fa-chevron-right" style="color:var(--primary);"></i>
                    </div>
                `;
            });

            document.getElementById('staffChatsList').style.display = 'block';
            document.getElementById('staffActiveChat').style.display = 'none';
            document.getElementById('btnBackChatList').style.display = 'none';
        }

        function openStaffClientChat(nick) {
            activeStaffClientNick = nick;
            document.getElementById('selectedClientHeader').innerText = `Atendendo: ${nick}`;
            document.getElementById('staffChatsList').style.display = 'none';
            document.getElementById('staffActiveChat').style.display = 'block';
            document.getElementById('btnBackChatList').style.display = 'inline-block';
            renderStaffMessages();
        }

        function backToStaffList() {
            activeStaffClientNick = null;
            renderStaffChatList();
        }

        function renderStaffMessages() {
            if (!activeStaffClientNick || !supportChats[activeStaffClientNick]) return;

            const box = document.getElementById('staffChatBox');
            box.innerHTML = '';
            const chatData = supportChats[activeStaffClientNick];

            chatData.messages.forEach(msg => {
                const msgClass = msg.sender === 'support' ? 'msg-user' : 'msg-support';
                box.innerHTML += `<div class="chat-msg ${msgClass}">${msg.text}</div>`;
            });
            box.scrollTop = box.scrollHeight;

            if (chatData.closed) {
                document.getElementById('staffChatControls').style.display = 'none';
            } else {
                document.getElementById('staffChatControls').style.display = 'flex';
            }
        }

        function sendStaffMessage() {
            const input = document.getElementById('staffChatInput');
            const txt = input.value.trim();
            if (!txt || !activeStaffClientNick) return;

            supportChats[activeStaffClientNick].messages.push({ sender: 'support', text: txt });
            input.value = '';
            renderStaffMessages();
        }

        function closeClientChatByStaff() {
            if (!activeStaffClientNick || !supportChats[activeStaffClientNick]) return;

            if (confirm(`Deseja fechar o chat e concluir o pedido de "${activeStaffClientNick}"?`)) {
                supportChats[activeStaffClientNick].closed = true;
                supportChats[activeStaffClientNick].messages.push({
                    sender: 'support',
                    text: '✅ O atendimento foi finalizado e seu pedido foi concluído! Agradecemos a preferência.'
                });

                renderStaffMessages();
                showToast(`Chat de ${activeStaffClientNick} concluído!`);
            }
        }

        /* Admin */
        function openAdminModal() {
            if (!isStaff) {
                openStaffAuthModal();
                return;
            }
            document.getElementById('adminModal').style.display = 'flex';
            renderAdminProducts();
            renderAdminOrders();
        }
        function closeAdminModal() { document.getElementById('adminModal').style.display = 'none'; }

        function switchAdminTab(tab) {
            document.querySelectorAll('.tab-nav-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');

            document.getElementById('admTabProducts').style.display = tab === 'products' ? 'block' : 'none';
            document.getElementById('admTabOrders').style.display = tab === 'orders' ? 'block' : 'none';
            document.getElementById('admTabSettings').style.display = tab === 'settings' ? 'block' : 'none';
        }

        function renderAdminProducts() {
            const list = document.getElementById('adminProductList');
            list.innerHTML = '';
            products.forEach(p => {
                list.innerHTML += `
                    <div style="display:flex; justify-content:space-between; align-items:center; background:#05070D; padding:10px; border-radius:8px; margin-bottom:6px; font-size:12px;">
                        <span><strong>${p.name}</strong> (${p.category}) - <span style="color:#10B981;">R$ ${p.price.toFixed(2)}</span></span>
                        <button style="background:#EF4444; border:none; color:white; padding:4px 8px; border-radius:4px; cursor:pointer;" onclick="deleteProductAdmin(${p.id})">Excluir</button>
                    </div>
                `;
            });
        }

        function renderAdminOrders() {
            const list = document.getElementById('adminOrdersList');
            list.innerHTML = '';

            if (salesHistory.length === 0) {
                list.innerHTML = `<div style="text-align:center; color:var(--text-muted); padding:20px;">Nenhum pedido realizado ainda.</div>`;
                return;
            }

            salesHistory.forEach(o => {
                list.innerHTML += `
                    <div style="background:#05070D; border:1px solid var(--border-neon); padding:12px; border-radius:10px; margin-bottom:10px; font-size:12px;">
                        <div style="display:flex; justify-content:space-between; font-weight:700;">
                            <span>Cliente: ${o.nick}</span>
                            <span style="color:#10B981;">R$ ${o.total.toFixed(2)}</span>
                        </div>
                        <div style="color:var(--accent); margin-top:4px;">Comprovante: ${o.receipt || 'Nenhum'}</div>
                    </div>
                `;
            });
        }

        function addProductAdmin() {
            const name = document.getElementById('admName').value;
            const price = parseFloat(document.getElementById('admPrice').value);
            const category = document.getElementById('admCategory').value;
            const stock = document.getElementById('admStock').value;
            const img = document.getElementById('admImg').value || "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400";
            const desc = document.getElementById('admDesc').value;

            if (!name || !price) {
                alert('Informe Nome e Preço do produto!');
                return;
            }

            products.push({ id: Date.now(), name, price, category, stock, img, desc });
            renderProducts();
            renderAdminProducts();
            showToast('Produto cadastrado com sucesso!');
        }

        function deleteProductAdmin(id) {
            products = products.filter(p => p.id !== id);
            renderProducts();
            renderAdminProducts();
            showToast('Produto removido.');
        }

        function saveSettingsAdmin() {
            const key = document.getElementById('admPixConfig').value;
            document.getElementById('pixKey').innerText = key;
            showToast('Configurações salvas!');
        }

        function updateAdminStats() {
            const totalSales = salesHistory.reduce((acc, o) => acc + o.total, 0);
            document.getElementById('statSales').innerText = `R$ ${totalSales.toFixed(2)}`;
            document.getElementById('statOrdersCount').innerText = salesHistory.length;
            document.getElementById('statProdCount').innerText = products.length;
        }

        renderProducts();
    </script>
</body>

</html>
